###############################################################################
# Combined env for the FaceApp stack + the face_auth service.
#
# Both compose projects can share this single file — each reads only the vars
# it references, so unused keys are simply ignored. FaceApp runs as project
# "${COMPOSE_PROJECT_NAME}"; face_auth runs as its own project (-p face_auth).
###############################################################################

# ===========================================================================
# SECTION A — FaceApp stack (Laravel API + React kiosk + Java gateway + Caddy)
# ===========================================================================

COMPOSE_PROJECT_NAME=faceapp-stack

FACEAPP_DOMAIN=faceapp.example.com
FACEAPP_API_DOMAIN=faceapp-api.example.com
FACEAPP_API_ORIGIN=https://faceapp-api.example.com

LARAVEL_APP_ENV=production
LARAVEL_APP_DEBUG=false
LARAVEL_APP_NAME=FaceApp API
LARAVEL_APP_KEY=base64:KeNF/zMNUppHZ7jLIQHJuGrhhZRL7rqpqChDWPqgxf8=
LARAVEL_SESSION_COOKIE=faceapp_api_session
# Leave blank for a host-only cookie. This is the safest option for the
# FaceApp admin/API domain behind the shared reverse proxy.
LARAVEL_SESSION_DOMAIN=
LARAVEL_SESSION_SECURE_COOKIE=true

GATEWAY_DEVICE_KEY=YOUR_DEVICE_KEY
GATEWAY_SECRET=YOUR_DEVICE_SECRET
GATEWAY_TIMEOUT_SECONDS=10
GATEWAY_DEFAULT_PERSON_TYPE=1
GATEWAY_DEFAULT_VERIFY_STYLE=1
GATEWAY_DEFAULT_AC_GROUP_NUMBER=0
GATEWAY_DEFAULT_PHOTO_QUALITY=1
GATEWAY_IMAGE_BASE_URL=http://face-api.qbot.jp/storage
GATEWAY_CALLBACK_BASE_URL=http://face-api.qbot.jp
GATEWAY_PERSON_VERIFY_RETRIES=5
GATEWAY_PERSON_VERIFY_DELAY_MS=1000
GATEWAY_VERIFY_RETRIES=5
GATEWAY_VERIFY_DELAY_MS=1500
GATEWAY_HEARTBEAT_INTERVAL_SECONDS=60
GATEWAY_ONLINE_WINDOW_SECONDS=180

GATEWAY_DEVICE_PORT=10010
GATEWAY_SDK_PORT=10011

FACEAPP_EXTERNAL_API_TOKEN=

# ---- FaceApp → face_auth integration (consumed by the Laravel api container) ----
# Base URL WITHOUT the /api/v1 suffix. Over the shared Docker network this is the
# face_auth compose service name + its internal port (= API_PORT in section B);
# from the host it would be http://localhost:${API_PORT}.
FACE_AUTH_BASE_URL=http://face_auth:8080
# Public API key issued by face_auth (its admin UI / seeding). Server-side only —
# never exposed to the browser. Not part of face_auth's own env; you mint it there.
FACE_AUTH_API_KEY=
# Device the "Verify with Face" flow targets when none is specified
# (a device id from face_auth's GET /api/v1/devices).
FACE_AUTH_DEFAULT_DEVICE_ID=
FACE_AUTH_TIMEOUT_SECONDS=10
FACE_AUTH_POLL_MAX_SECONDS=60
FACE_AUTH_POLL_INTERVAL_MS=1500
# Who opens the turnstile after a face verifies:
#   app_turnstile      = face_auth verifies only; the app opens the gate (default, safe)
#   face_auth_open_door = the Hikvision relay is wired to the turnstile; face_auth opens it
FACE_AUTH_GATE_MODE=app_turnstile
# Fail-closed identity check. KEEP true IN PRODUCTION: the gate opens only when
# face_auth returns a matched identity for the member. Set false ONLY for local
# integration testing (then a missing identity falls back to the session binding,
# logged + flagged — a mismatched identity is always blocked regardless).
FACE_AUTH_REQUIRE_MATCHED_IDENTITY=true

# ===========================================================================
# SECTION B — face_auth service (Go + Fiber, Postgres + Redis + MinIO + agent)
# Run from the face_auth repo: docker compose -p face_auth up -d
# ===========================================================================

# Postgres
PG_USER=hik
PG_PASSWORD=hikpush
PG_DB=hikpush

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=hikpush
MINIO_CONSOLE_PORT=9001
# Public URL base for serving images (leave empty to proxy via backend)
MINIO_PUBLIC_BASE=

# Ports exposed on host
PUSH_PORT=7660
# API_PORT is the face_auth backend port. FACE_AUTH_BASE_URL (section A) must
# point at this service — over docker as http://face_auth:8080, on host as
# http://localhost:8080. Keep them in sync if you change this.
API_PORT=8080
ADMIN_PORT=5173

# Frontend build-time API URL for the face_auth ADMIN UI (not the FaceApp kiosk;
# the kiosk uses FACEAPP_API_ORIGIN above). Must be reachable from the browser.
VITE_API_URL=http://localhost:8080

# Auth mode for Hik devices
# true  = device skips Login, auto-registers on first contact (easiest for testing)
# false = device must Login with matching DEVICE_DEFAULT_PASSWORD
NO_AUTH_MODE=false
DEVICE_DEFAULT_PASSWORD=crave2168

LOG_LEVEL=info

# ---- face_auth-agent (LAN-side bridge for cloud deployments) ----
# Cloud URL the agent should connect to (use ws:// for local, wss:// for prod TLS).
CLOUD_URL=ws://localhost:8080
# Agent ID + name (you create these in the Agents tab; copy the token from there).
AGENT_ID=
AGENT_NAME=LAN agent
AGENT_TOKEN=

# USB QR scanner: strip this from the start / end of every scan before
# forwarding to the cloud. Most scanners can be programmed to add a prefix
# or suffix; e.g. yours emits "in#TOKEN" → set QR_STRIP_PREFIX=in#
QR_STRIP_PREFIX=in#
QR_STRIP_SUFFIX=
QR_LISTEN_PORT=7771

# Native USB QR scanner (Linux only). The agent opens this device and reads
# keystrokes directly — no helper script needed.
#   QR_DEVICE       = explicit path (preferred): /dev/input/eventN
#                     or /dev/input/by-id/usb-MyScanner-event-kbd
#   QR_DEVICE_AUTO  = "true" → agent auto-picks a scanner-looking device
QR_DEVICE=
QR_DEVICE_AUTO=

# Raw TCP byte dumper — when set (e.g. 7661) it captures whatever protocol the device
# speaks and exposes it via the admin Bridge tab. Recommended to leave on for testing.
DEBUG_PORT=7661

# Public host/port the device will use to reach this server.
# - For LAN testing: same as your machine's LAN IP (e.g. 192.168.100.69)
# - For cloud: your VPS hostname / IP (e.g. push.face_auth.qbot.now)
# These show up in the Bridge tab as the URLs to paste into the device's ISUP/OTAP config.
PUBLIC_PUSH_HOST=192.168.100.69
PUBLIC_PUSH_URL=

# If set, backend also listens on this port with a self-signed TLS cert.
# Use this for testing OTAP over HTTPS.
TLS_PORT=7670

# IP address the Hik device should push events to via HTTP alarm host.
# Set this to the IP of THIS host on the LAN that the device can reach.
EVENT_CALLBACK_IP=192.168.100.69
